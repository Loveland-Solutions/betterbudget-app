<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (#109, #171): the Windows build packed as it is, with
  MakeAppx, by .github/workflows/windows.yml. The Store signs it, so it is packed
  unsigned. The identity is the one Partner Center gave the reserved name
  (2026-10-23). VERSION is filled in by the workflow from pubspec.yaml, as the
  Store wants it: three numbers and a 0.

  It asks for nothing but to run as a desktop app (runFullTrust): no internetClient,
  no other capability. The tiles are drawn by design/icon/app_icon.py.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="LovelandSolutions.BetterBudget"
    Publisher="CN=5854F357-D1B6-4392-B31F-5AA8368A6A1C"
    Version="VERSION"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BetterBudget</DisplayName>
    <PublisherDisplayName>Loveland Solutions</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="BetterBudget" Executable="BetterBudget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BetterBudget"
        Description="A private, offline budgeting app."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

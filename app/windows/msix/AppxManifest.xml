<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (#109, #171): the Windows build packed as it is, with
  MakeAppx, by .github/workflows/windows.yml. The Store signs it, so it is packed
  unsigned. The identity is the one Partner Center gave the reserved name
  (2026-10-23). VERSION is filled in by the workflow from pubspec.yaml, as the
  Store wants it: three numbers and a 0.

  It asks for nothing but to run as a desktop app (runFullTrust) and to write its own
  folder in AppData for real (unvirtualizedResources): no internetClient, no other
  capability. The tiles are drawn by design/icon/app_icon.py.

  Where the ledger lives (#246, owner's pick 2026-10-23): in the folder the zip
  download uses, %APPDATA%\Loveland Solutions\BetterBudget (named by Runner.rc's
  CompanyName and ProductName). Left to itself, Windows sends a packaged app's new
  files in AppData to a private folder of the package and deletes it on uninstall,
  taking the ledger, its daily copies and the saved recovery key with it. Windows 11
  reads the ExcludedDirectory and leaves only that folder real; Windows 10 reads
  desktop6's "disabled" and leaves all of AppData real. 1903 (18362) is the first
  Windows 10 that has either, so it is the lowest the package installs on.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap rescap desktop6 virtualization">

  <Identity
    Name="LovelandSolutions.BetterBudget"
    Publisher="CN=5854F357-D1B6-4392-B31F-5AA8368A6A1C"
    Version="VERSION"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BetterBudget</DisplayName>
    <PublisherDisplayName>Loveland Solutions</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\Loveland Solutions\BetterBudget</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="BetterBudget" Executable="BetterBudget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BetterBudget"
        Description="A private, offline budgeting app."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
